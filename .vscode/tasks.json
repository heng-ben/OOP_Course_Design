{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译OOP项目",
            "type": "shell",
            "command": "g++",
            "args": [
                "-finput-charset=UTF-8",
                "-fexec-charset=GBK",
                "-g",
                "-std=c++17",
                "-I", "${workspaceFolder}/include",
                "${workspaceFolder}/src/*.cpp",
                "-o", "${workspaceFolder}/build/main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "编译src下所有cpp文件，输出到build目录"
        }
    ]
}
